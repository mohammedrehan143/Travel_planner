# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase Credentials (Required for persistence and auth)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------
# Agentic AI Provider Configuration (Groq Ultra-Fast LPU Recommended)
# ----------------------------------------------------------------------
# Get your free Groq API key from: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Available Groq models: openai/gpt-oss-120b, qwen/qwen3.8-27b, openai/gpt-oss-20b, llama-3.3-70b-versatile, llama-3.1-8b-instant

# Alternative AI Provider: Google Gemini
# GEMINI_API_KEY=AIzaSy...
# GEMINI_MODEL=gemini-2.5-flash

# Alternative AI Provider: OpenAI
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o

# AI Provider Selection: "groq" | "gemini" | "openai" | "auto"
AI_PROVIDER=groq

# External Integration Keys (Optional: fallbacks & free public endpoints are integrated)
# Places / Google Maps API (Optional, uses high-fidelity POI database and OSM fallback if absent)
MAPS_API_KEY=
# OpenWeather / Weather API (Optional, uses free live Open-Meteo endpoint by default)
WEATHER_API_KEY=

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase Credentials (Required for persistence and auth)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Provider Configuration (OpenAI or compatible endpoint like Gemini/Ollama/OpenRouter)
# Optional in dev: The agent orchestrator runs with deterministic fallback tools if key is omitted
OPENAI_API_KEY=sk-proj-...
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/ # e.g. for Gemini
OPENAI_MODEL=gpt-4o

# External Integration Keys (Optional: fallbacks & free public endpoints are integrated)
# Places / Google Maps API (Optional, uses high-fidelity POI database and OSM fallback if absent)
MAPS_API_KEY=
# OpenWeather / Weather API (Optional, uses free live Open-Meteo endpoint by default)
WEATHER_API_KEY=

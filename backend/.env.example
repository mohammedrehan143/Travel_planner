# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Supabase Credentials (Required for persistence and auth)
# Obtain these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ----------------------------------------------------------------------
# Agentic AI Provider Configuration (Google Gemini Recommended)
# ----------------------------------------------------------------------
# Get your free Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.5-flash
# Available models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash

# Alternative AI Provider: OpenAI
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4o

# AI Provider Selection: "gemini" | "openai" | "auto"
AI_PROVIDER=gemini

# External Integration Keys (Optional: fallbacks & free public endpoints are integrated)
# Places / Google Maps API (Optional, uses high-fidelity POI database and OSM fallback if absent)
MAPS_API_KEY=
# OpenWeather / Weather API (Optional, uses free live Open-Meteo endpoint by default)
WEATHER_API_KEY=
